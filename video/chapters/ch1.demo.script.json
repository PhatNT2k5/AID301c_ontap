      "id": "etl",
      "title": "Data ingestion và ETL",
      "scenes": [
        {
          "type": "code",
          "pose": "idle",
          "headline": "ETL: lấy, biến đổi, nạp",
          "data": {
            "lines": [
              {
                "text": "import pandas as pd",
                "beat": "l1"
              },
              {
                "text": "import sqlite3",
                "beat": "l2"
              },
              {
                "text": ""
              },
              {
                "text": "conn = sqlite3.connect(\"aavail.db\")",
                "beat": "l4",
                "marks": [
                  {
                    "text": "\"aavail.db\"",
                    "beat": "db"
                  }
                ]
              },
              {
                "text": "df_db = pd.read_sql(\"SELECT * FROM customers\", conn)",
                "beat": "l5"
              },
              {
                "text": "df_csv = pd.read_csv(\"streams.csv\")",
                "beat": "l6"
              },
              {
                "text": "df = df_db.merge(df_csv, on=\"customer_id\")",
                "beat": "l7",
                "marks": [
                  {
                    "text": "df =",
                    "beat": "frame"
                  },
                  {
                    "text": "\"customer_id\"",
                    "beat": "key"
                  }
                ]
              },
              {
                "text": "assert df[\"customer_id\"].is_unique",
                "beat": "l8"
              }
            ],
            "stages": [
              {
                "id": "E",
                "label": "Extract",
                "hint": "read_sql · read_csv"
              },
              {
                "id": "T",
                "label": "Transform",
                "hint": "merge"
              },
              {
                "id": "L",
                "label": "Load",
                "hint": "DataFrame · assert"
              }
            ]
          },
          "narration": [
            "ETL là viết tắt của Extract, Transform và Load.",
            "Extract là lấy dữ liệu thô từ nhiều nguồn.",
            "Ở đây ta đọc bảng customers trong database của AAVAIL.",
            "Rồi đọc thêm dữ liệu streams từ một file CSV.",
            "Transform là làm sạch và gộp hai nguồn theo customer id.",
            "Load là đưa kết quả vào một DataFrame để phân tích.",
            "Cuối cùng kiểm tra dữ liệu, không để khách hàng bị trùng."
          ],
